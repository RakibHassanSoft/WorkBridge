# Copy to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=4000

# PostgreSQL (Prisma). Render external connections require SSL.
DATABASE_URL="?sslmode=require"

# Auth
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"
# CORS (comma-separated origins; * allows all in dev)
CORS_ORIGIN="*"

# Gemini AI (optional). Leave empty to use the deterministic judge only.
# With a key, the judge also LOOKS at uploaded images / scanned PDFs.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"

# Required to self-register a MODERATOR account. Leave empty to disable
# moderator registration entirely (recommended once your coordinators exist).
MODERATOR_SIGNUP_CODE="123456"

# App + API public URLs (used for SSLCommerz redirects/callbacks).
# APP_URL must include the frontend base path if it has one (e.g. GitHub Pages:
# "https://<user>.github.io/WorkBridge"). PUBLIC_API_URL must be reachable by
# SSLCommerz, so use a public URL (not localhost) outside local testing.
APP_URL="http://localhost:3000"
PUBLIC_API_URL="http://localhost:4000/api/v1"

# SSLCommerz payment gateway. Leave store id/password empty to disable the
# gateway (escrow is held immediately, for local dev).
SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASSWORD=""
SSLCOMMERZ_IS_LIVE="false"
