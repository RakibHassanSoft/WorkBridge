# Copy to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=4000

# PostgreSQL (Prisma). Render external connections require SSL.
DATABASE_URL="?sslmode=require"

# Auth
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"
llrtqRUoYiP1wzrQVAgb-8U-1g
# CORS (comma-separated origins; * allows all in dev)
CORS_ORIGIN="*"

# Gemini AI (optional). Leave empty to use the deterministic engine only.
GEMINI_API_KEY=""
GEMINI_MODEL="Gemini API Key 4"

# Required to self-register a MODERATOR account. Leave empty to disable
# moderator registration entirely (recommended once your coordinators exist).
MODERATOR_SIGNUP_CODE="123456"
